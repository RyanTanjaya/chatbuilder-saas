# Copy to .env and fill in actual values. NEVER commit .env.

# Supabase Postgres — session pooler URL, port 5432 (required for Prisma migrations)
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-1-ap-southeast-2.pooler.supabase.com:5432/postgres"

# OpenAI API key (from https://platform.openai.com/api-keys)
OPENAI_API_KEY="sk-proj-..."

# JWT signing secret — generate with: openssl rand -hex 32
JWT_SECRET="replace-me-with-random-hex"

# Server config
PORT=4000
NODE_ENV=development

# CORS origin for the React dashboard
CLIENT_ORIGIN="http://localhost:5173"

# Public URL of this API (used by widget.js + iframe). In dev = http://localhost:4000
PUBLIC_API_URL="http://localhost:4000"
