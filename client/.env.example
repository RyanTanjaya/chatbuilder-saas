# Copy to .env.local and fill in. NEVER commit .env files.

# Public URL of the backend API. In dev, the Vite proxy in vite.config.ts handles
# `/api/*` automatically, so leave this unset (the app falls back to "/api"). In
# prod set to the absolute Render URL, e.g. https://chatbuilder-api.onrender.com/api
VITE_API_BASE_URL="/api"

# Origin where the embed widget (widget.js) is served from — the Express/Render
# host, WITHOUT the /api suffix. Used by Embed.tsx to build the <script> snippet.
# In dev this is the local API; in prod set to the Render URL.
VITE_WIDGET_API_URL="http://localhost:4000"
